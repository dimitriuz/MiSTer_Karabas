# The Karabas_Profi file list. Never edited by the Quartus IDE: the upstream
# half comes from build/upstream/upstream.qip (tools/prepare_upstream.py, the
# order of src/karabas_go.prj), the rest is spelled out below.
#
# rtl/compat/unisim_vcomponents.vhd stands in for the Xilinx unisim library
# the upstream VHDL `use`s; rtl/replaced/* are the port's replacements for
# the upstream files check_upstream.sh guards.

set_global_assignment -name VHDL_FILE rtl/compat/unisim_vcomponents.vhd -library unisim

set_global_assignment -name QIP_FILE build/upstream/upstream.qip
set_global_assignment -name QIP_FILE rtl/pll.qip

set_global_assignment -name VHDL_FILE rtl/replaced/clock.vhd
set_global_assignment -name VHDL_FILE rtl/replaced/memory.vhd
set_global_assignment -name VHDL_FILE rtl/clk/clkmux2.vhd
set_global_assignment -name VHDL_FILE rtl/clk/clkgate.vhd
set_global_assignment -name VHDL_FILE rtl/clk/clkdiv4.vhd

set_global_assignment -name VHDL_FILE rtl/mem/cdc_fifo.vhd
set_global_assignment -name VHDL_FILE rtl/mem/sdram_nowait.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/gs_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/mt32_mix.sv

# Storage (stage 4b): the sector engine of the machine's disk interface
# (img_sdc's place) over MiSTer disk slots 2/3, the two IDE images.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/disk/img_src.sv

# Floppy (stage 4c): the drive model, the track store (DDR3 master 1 behind
# rtl/mem/ddr_arb.sv) and the image source for the disk slots 4/5.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/ddr_arb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/disk/fdd_store.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/disk/fdd_src.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/disk/td0_lzh.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/disk/floppy.sv

# Tape (stage 4a): rtl/tape/tape.sv and rtl/tape/tzxplayer.vhd are copies of
# ZX-Spectrum_MISTer at c2c4e6f (the ZX core's player), with two deviations:
# both data-block lead-ins are 8064 pulses instead of the ZX 3220/4031,
# because the Profi ROM consumes the data lead-in while its LD_WAIT/LD_LEADER
# run (board: 3223/4031 fail, 8064 loads; see the comments in the two files);
# and tape.sv gained a `blk_seek` input so the converted CSW stream can drop
# its RLE state when `tape_conv.sv` jumps to another block (Tape previous/next).
# The player reads through rtl/tape/tape_src.sv, this port's SD-file path.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tape/tape_conv.sv
set_global_assignment -name VHDL_FILE rtl/tape/tzxplayer.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tape/tape.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tape/tape_src.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/ps2_hid.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/hotkeys.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/fdc_trace.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/core_beacon.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/pc_trace.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/mcu_spi_master.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/bcd_clock.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/mcu_emu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/uart_route.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/host/mount_settle.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/vframe_gen.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/video_cdc.sv

set_global_assignment -name SDC_FILE Karabas_Profi.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Karabas_Profi.sv
